{
  "name": "clinic-booking-api",
  "version": "1.0.0",
  "description": "Clinics publish time slots; patients book them. A slot can never be double-booked.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testMatch": ["**/tests/**/*.test.js"],
    "testTimeout": 15000
  }
}
